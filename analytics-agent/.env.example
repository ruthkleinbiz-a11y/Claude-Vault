# ── Windsor.ai ──────────────────────────────────────────────────────────────
WINDSOR_API_KEY=your_windsor_api_key_here
WINDSOR_ACCOUNT_ID=your_windsor_account_id_here

# ── X / Twitter API ─────────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_USERNAME=your_twitter_handle_here

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Sheets ────────────────────────────────────────────────────────────
# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google-service-account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ── Email Delivery (SendGrid) ────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key_here
REPORT_FROM_EMAIL=analytics@ruthklein.com
REPORT_TO_EMAIL=claudia@every-task.com

# ── Windsor.ai connector IDs (don't change these) ───────────────────────────
# These are the slugs Windsor uses for each platform
# instagram, facebook, youtube, tiktok_organic, googleanalytics4,
# pinterest, gohighlevel
